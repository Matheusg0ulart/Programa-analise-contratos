# ==============================================================================
# SISTEMA MULTI-AGENTE CORPORATIVO COM RAG AVANÇADO
# Configurações de Ambiente
# ==============================================================================

# Modo de Provedor LLM: 'mock' (teste offline determinístico), 'openai', 'gemini', 'ollama'
LLM_PROVIDER=mock

# Chaves de API para Provedores LLM Reais (opcional se LLM_PROVIDER=mock)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Configuração de Cache Semântico (Redis)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.90
SEMANTIC_CACHE_TTL_SECONDS=86400

# Configuração do Banco Vetorial (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=corporate_audit_chunks

# Orquestração de Agentes (LangGraph)
MAX_AUDIT_REVISIONS=2
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RAG_TOP_K=5
RERANK_TOP_N=3

# Servidor API
HOST=0.0.0.0
PORT=8000
DEBUG=true
